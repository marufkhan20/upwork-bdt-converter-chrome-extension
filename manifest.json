{
  "manifest_version": 3,
  "name": "Upwork BDT Converter",
  "version": "1.0",
  "description": "Converts Upwork contract earnings from USD to BDT with custom fees.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.upwork.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.upwork.com/nx/wm/freelancer/home*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
